{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MecDrive",
  "version": "1.0.0",
  "identifier": "com.hugomec.mecdrive",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MecDrive",
        "width": 1100,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Hugo Mec",
    "shortDescription": "Baixa pastas do Google Drive exatamente como estão",
    "resources": {
      "../bin/rclone.exe": "bin/rclone.exe",
      "target/release/mecdrive-cli.exe": "mecdrive-cli.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "MecDrive"
}